# Copy to .env and fill in real values. Never commit .env.

# Port for the Express API (Vite's dev server on 3000 proxies /api here).
PORT=3001

# ElevenLabs text-to-speech. Without a real key, "Read aloud" falls back to the
# browser's built-in speech synthesis.
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
# Optional overrides:
# ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
# ELEVENLABS_MODEL_ID=eleven_flash_v2_5

# Reserved for authentication (not used yet). Use a long random value in production.
JWT_SECRET=super_secret_jwt_key_change_in_production

# Optional: comma-separated origins allowed to call the API directly (CORS).
# CORS_ORIGIN=http://localhost:3000
